<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TerminalMcp.Core</RootNamespace>
    <AssemblyName>TerminalMcp.Core</AssemblyName>
    <PackageId>AIGuiders.TerminalMcp.Core</PackageId>
    <Version>0.1.5</Version>
    <Description>Durable shell habitat for MCP: job store, supervisor bridge, pwsh/cmd argv templates.</Description>
    <PackageTags>terminal;mcp;shell;durable;cdp;habitat</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TerminalMcp.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="TerminalMcp.Core.Tests/**" />
    <None Remove="TerminalMcp.Core.Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="templates\pwsh-host.ps1" LogicalName="TerminalMcp.Core.templates.pwsh-host.ps1" />
    <EmbeddedResource Include="templates\cmd-runner.cmd" LogicalName="TerminalMcp.Core.templates.cmd-runner.cmd" />
  </ItemGroup>
</Project>
