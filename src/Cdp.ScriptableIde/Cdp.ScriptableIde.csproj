<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <RootNamespace>Cdp.ScriptableIde</RootNamespace>
    <AssemblyName>Cdp.ScriptableIde</AssemblyName>
    <PackageId>AIGuiders.Cdp.ScriptableIde</PackageId>
    <Version>0.1.60</Version>
    <Authors>Dmitry Karataev; AIGuiders</Authors>
    <Company>AIGuiders</Company>
    <Description>CSX allowlist host for CDP: Debug/Roslyn/Git/Verify/Symbol/SemanticMap/Work/Refactor/Annotate/Insert/Fix/Generate/Body/Settings/Packages/Projects/Solutions facades over IScriptToolBus. CodeAnchor + BracketLocate.</Description>
    <PackageTags>cdp;mcp;code-anchor;bracket-locate;csx;cascade-ide;modelcontextprotocol</PackageTags>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageReference Include="Tomlyn" Version="2.9.0" />
    <ProjectReference Include="..\Cdp.Evidence\Cdp.Evidence.csproj"
                      Condition="Exists('..\Cdp.Evidence\Cdp.Evidence.csproj')" />
    <ProjectReference Include="..\Cdp.PackageIntelligence\Cdp.PackageIntelligence.csproj"
                      Condition="Exists('..\Cdp.PackageIntelligence\Cdp.PackageIntelligence.csproj')" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tools/**" />
    <None Include="tools/**" />
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
