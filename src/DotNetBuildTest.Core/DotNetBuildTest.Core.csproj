<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <RootNamespace>DotNetBuildTest.Core</RootNamespace>
    <AssemblyName>DotNetBuildTest.Core</AssemblyName>
    <!-- NuGet: Trusted Publishing → https://github.com/AI-Guiders/dotnet-build-test-core, workflow nuget-publish.yml -->
    <PackageId>AIGuiders.DotNetBuildTest.Core</PackageId>
    <Version>0.1.4</Version>
    <Authors>Dmitry Karataev; AIGuiders</Authors>
    <Company>AIGuiders</Company>
    <Description>Job coordinator, dotnet CLI runner, and structured build/test/publish results for dotnet-build-test-mcp and Cascade IDE AEE.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AI-Guiders/dotnet-build-test-core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AI-Guiders/dotnet-build-test-core.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet;msbuild;dotnet-test;mcp;cascade-ide;build-test</PackageTags>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="DotNetBuildTest.Core.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DotNetBuildTest.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetBuildTestParsers\DotNetBuildTestParsers.csproj"
                      Condition="Exists('..\DotNetBuildTestParsers\DotNetBuildTestParsers.csproj')" />
    <PackageReference Include="AIGuiders.DotNetBuildTestParsers" Version="0.1.2"
                      Condition="!Exists('..\DotNetBuildTestParsers\DotNetBuildTestParsers.csproj')" />
    <ProjectReference Include="..\Cdp.Evidence\Cdp.Evidence.csproj"
                      Condition="Exists('..\Cdp.Evidence\Cdp.Evidence.csproj')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
