<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <RootNamespace>AgentFindings.Core</RootNamespace>
    <AssemblyName>AgentFindings.Core</AssemblyName>
    <PackageId>AIGuiders.AgentFindings.Core</PackageId>
    <Version>0.2.0</Version>
    <Authors>Dmitry Karataev; AIGuiders</Authors>
    <Company>AIGuiders</Company>
    <Description>Workspace-local agent artifact-memo + task-DAG journal (jsonl, hash-gated). Host-neutral; not CIDE-specific. Used by AgentFindings MCP and in-proc hosts.</Description>
    <PackageTags>agent;findings;memo;mcp;journal;workflow</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AgentFindings.Core.Tests\**\*.cs" />
    <None Remove="AgentFindings.Core.Tests\**\*" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AgentFindings.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
