<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <RootNamespace>DotNetWorkspace.Core</RootNamespace>
    <AssemblyName>DotNetWorkspace.Core</AssemblyName>
    <PackageId>AIGuiders.DotNetWorkspace.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>Dmitry Karataev; AIGuiders</Authors>
    <Company>AIGuiders</Company>
    <Description>Solution/project graph IR (.slnx/.sln/.csproj/.fsproj) for federation hosts (Roslyn, FCS, LRC).</Description>
    <PackageTags>dotnet;slnx;msbuild;workspace;solution-graph</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DotNetWorkspace.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
