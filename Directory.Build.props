<Project>

  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>

    <LangVersion>14</LangVersion>

    <Nullable>enable</Nullable>

    <ImplicitUsings>enable</ImplicitUsings>

    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <Authors>AI Guiders</Authors>

    <Company>AI Guiders</Company>

    <Product>Guiders Core</Product>

    <RepositoryUrl>https://github.com/AI-Guiders/guiders-core</RepositoryUrl>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <GuidersCoreRoot>$(MSBuildThisFileDirectory)</GuidersCoreRoot>

  </PropertyGroup>

</Project>

